<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Provisioned for a future foreground-service promotion of the periodic sync worker
         (SyncWorker currently runs as a plain, comparatively quick WorkManager job - list +
         category/tag refresh, not a bulk recipe-detail download - so it doesn't call
         setForeground() yet). Kept declared so that doesn't require another manifest change. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ runtime permission for optional background sync result notifications. Sync never
         depends on it being granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested only when the recipe editor's Take photo action is used. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SyncwichApp"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Syncwich"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- usesCleartextTraffic=true: self-hosted Mealie instances are frequently plain HTTP on
             a local network (this app's whole audience is homelab/self-hosted Mealie users). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Syncwich.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Mealie's public recipe/cookbook links are portable across self-hosted domains. -->
            <intent-filter tools:ignore="AppLinkWarning,IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPattern="/g/home/r/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/g/home/c/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/g/home/r/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/g/home/c/.*" />
            </intent-filter>

            <!-- Receive shared text/assets; URL text is routed immediately and image handling is
                 consumed by the editor workflow. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialized manually in SyncwichApp (Configuration.Provider) so Hilt
             can inject HiltWorkerFactory into it - disable the default ContentProvider-based
             auto-init to avoid double initialization. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Camera output is private and is copied into the editor's draft media cache after
             capture, so failed/offline saves retain the selected image. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/recipe_editor_file_paths" />
        </provider>
    </application>

</manifest>
